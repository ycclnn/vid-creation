{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ShortFilm 默认权限：前端调用核心 API 与事件",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:path:default",
    "dialog:default"
  ]
}
